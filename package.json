{
  "name": "dac-booking-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "fixture": "tsx --tsconfig scripts/tsconfig.json scripts/dev-fixture.ts",
    "dev:session": "tsx --tsconfig scripts/tsconfig.json scripts/dev-session.ts",
    "pdf:sample": "tsx --tsconfig scripts/tsconfig.json scripts/render-sample-pdf.tsx",
    "verify:storage": "tsx --tsconfig scripts/tsconfig.json scripts/verify-storage.ts",
    "verify:submit": "tsx --tsconfig scripts/tsconfig.json scripts/verify-submit.ts",
    "verify:sign": "tsx --tsconfig scripts/tsconfig.json scripts/verify-sign.ts",
    "verify:pdf": "tsx --tsconfig scripts/tsconfig.json scripts/verify-pdf.ts",
    "verify:notify": "tsx --tsconfig scripts/tsconfig.json scripts/verify-notify.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "dev:clean": "tsx --tsconfig scripts/tsconfig.json scripts/dev-clean.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "7.10.1",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.8",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.0.5"
  }
}
