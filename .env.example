# ---------------------------------------------------------------------------
# DAC Booking Form Portal — environment
# Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Local development (PostgreSQL running on this machine):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dac_booking?schema=public"
#
# Production — Supabase, region ap-south-1 (Mumbai) ONLY. Verify the region at
# project creation; it cannot be changed afterwards. Use the "session" pooler
# for migrations and the "transaction" pooler for the app if you enable PgBouncer.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Session / crypto -----------------------------------------------------
# 32-byte base64 key used to encrypt PAN and Aadhaar at rest (AES-256-GCM).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this makes existing ciphertext unreadable — do not change casually.
FIELD_ENCRYPTION_KEY=""

# 32-byte base64 secret used to sign/verify session cookies.
# Generate the same way. Rotating it logs everybody out (safe).
SESSION_SECRET=""

# --- App ------------------------------------------------------------------
# Public origin, used for absolute links in emails and for cookie security.
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Vercel Cron ----------------------------------------------------------
# Shared secret so /api/health and the cron routes reject public callers.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Not required until later phases — left here so the full surface is visible.
# ---------------------------------------------------------------------------

# --- Document storage (Phase 3) -------------------------------------------
# Supporting documents are PAN cards, Aadhaar cards and photographs, so the
# bytes are covered by the India-residency rule exactly as the database is.
#
# With NOTHING set below, the app writes to the local filesystem (default
# `../dac-storage`, outside the repository). That is the development default
# and needs no cloud account.
#
# Setting SUPABASE_SERVICE_ROLE_KEY switches it to Supabase Storage. There is
# no other change to make — no code edit, no flag.
#
# LOCAL_STORAGE_DIR="D:/OCT-2026/dac-storage"
#
# Force a driver, overriding the rule above ("local" | "supabase"):
# STORAGE_DRIVER="local"
#
# Supabase Storage — PRIVATE bucket, project region ap-south-1 (Mumbai) ONLY.
# The service-role key bypasses row-level security; it is used from server code
# only and must never appear in a NEXT_PUBLIC_ variable.
# NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_STORAGE_BUCKET="booking-documents"
#
# The app refuses to start in production if the region is not ap-south-1. It
# infers the region from the DATABASE_URL pooler host; set this if that fails.
# SUPABASE_REGION="ap-south-1"
#
# Self-hosting on a real disk instead of Vercel? Then, and only then:
# ALLOW_LOCAL_STORAGE="yes"

# --- Email digest (Phase 7) ------------------------------------------------
# OPTIONAL. Without a key the digest reports itself as not configured and the
# in-app notification queue carries on unaffected — email is a prompt to go and
# look, never the thing being delivered.
#
# Resend's free tier is 3,000 a month but capped at 100 a DAY, and the day is
# the binding limit: one email per signature would run out at about eleven
# bookings. So it sends ONE message per person per night listing everything
# they have not read.
#
# RESEND_FROM must be on a domain verified in Resend. Until one is, Resend's
# own onboarding@resend.dev works but only delivers to your own address.
# RESEND_API_KEY=""
# RESEND_FROM="DAC Booking <noreply@dacdevelopers.com>"
# RESEND_DAILY_CAP="100"

# --- Google Sheets: the project master list (PLAN.md §2A) -----------------
# OPTIONAL. Leave these unset and the project list is maintained by hand in
# Admin -> Projects; the sync reports itself as "not configured" and nothing
# breaks. The booking form always reads Postgres, never Google.
#
# Setting up:
#   1. Google Cloud console -> create a service account -> add a JSON key.
#   2. Enable the "Google Sheets API" for that project.
#   3. Share the sheet with the service account's email as a **Viewer**.
#      (It only ever reads: the scope requested is spreadsheets.readonly.)
#
# The private key is multi-line. Keep it on ONE line with literal 
 escapes
# and wrap it in double quotes, exactly as it appears in the JSON key file.
#
# GOOGLE_SERVICE_ACCOUNT_EMAIL="dac-sheets@your-project.iam.gserviceaccount.com"
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
MIIEv...
-----END PRIVATE KEY-----
"
#
# The sheet id is the long string in its URL:
#   https://docs.google.com/spreadsheets/d/<THIS BIT>/edit
# GOOGLE_PROJECTS_SHEET_ID=""
# GOOGLE_PROJECTS_SHEET_TAB="Projects"
#
# Expected columns (found by header text, in any order):
#   Project Code  - the stable key. Strongly recommended: without it, renaming
#                   a project in the sheet creates a second project instead of
#                   renaming the first.
#   Project Name  - required.
#   Location      - optional.
#   Active        - optional. "No"/"Closed"/"Archived" hide it from the
#                   dropdown; anything else, including blank, keeps it.

# Phase 7 — the outbound mirror: one row per completed booking,
# non-sensitive columns ONLY. Never Aadhaar, PAN, DOB, addresses,
# phone numbers or document links.
# GOOGLE_MIRROR_SHEET_ID=""
# GOOGLE_MIRROR_SHEET_TAB="Bookings"
